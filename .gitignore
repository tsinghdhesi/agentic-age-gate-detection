# Environment / secrets
.venv/
.env
.env.*

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# OS / editors
.DS_Store
.idea/
.vscode/

# ---------------------------------------------------------------------------
# Data. Small hand-curated INPUTS are tracked (data/seed/, the hand-labeled
# gold set). Everything collected or generated by a run is not.
# ---------------------------------------------------------------------------

# Run outputs
data/screenshots/
data/dom/
data/logs/
data/html/
*.log

# Databases
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db

# Raw gold-set intermediates (fetched page dumps, candidate/score scratch files)
data/labels/goldset_raw/

# Keep the empty artifact dirs present in git
!data/screenshots/.gitkeep
!data/dom/.gitkeep
!data/logs/.gitkeep

# Throwaway spike output (annotated PNGs / screenshots)
spike/out/
